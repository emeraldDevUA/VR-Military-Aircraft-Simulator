--- !u!114 &8564501691308148749
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: "<b>1</b>.  Select the <b>Play/Stop</b> button at the top of
      the Editor window to enter Play mode.\n\n<b>2</b>.  Use the arrow keys or the
      WASD keys on your keyboard to make the robot walk. \n\n<b>3</b>.  Press the
      spacebar to jump and move your mouse to look around.\n\n<b>Tip</b>:  Click
      in the <b>Game</b> view to lock and hide your mouse cursor. Press <b>Escape</b>
      to view your cursor again.\n\n<b>4</b>.  Have the robot collect the star at
      the top of the small yellow box.\n\n<b>5</b>.  When you're ready, select the
      <b>Play/Stop</b> button again to exit Play mode. \n\n<b>Note</b>:  You can
      hold <b>Shift</b> to make the robot run!"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
