  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "This is the <b>Hierarchy</b> window.\n\nThe <b>Hierarchy</b>
      window lists the GameObjects in your scene and helps you organize them.\n\n<b>GameObjects</b>
      are the things in your scene. \n\nMany GameObjects represent physical objects,
      but they can also be lights, sounds, visual effects, and more."
