--- !u!114 &464756824150140778
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Visual effects (VFX) are simulated motion effects added to enhance
      a scene, ranging from a subtle splash of water to a massive fiery explosion.\n\nUnity
      has tools to create visual effects and particles that can simulate fire, gas,
      rain, snow, and many other phenomena. \n\nWe've prepared some ready-to-use
      visual effects for your scene. \n\nAdd them to your scene for dramatic effect!\n"
--- !u!114 &633598123071247173
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "You\u2019ve probably already noticed the shadows and reflections
      that come from the simulated sun, controlled by the <b>Directional Light</b>
      GameObject.\n\nUnity has many tools for simulating light and lighting effects.
      \n\nYou can now access the secret room, but it\u2019s quite dark inside. Let\u2019s
      add some lights to make the star stand out more."
--- !u!114 &693277190739722549
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: "<b >1</b>.  In the <b >Project</b> window, open the <b >Assets</b>
      > <b>VFX</b> folder.\n\n<b>2</b>.  Click and drag any of the VFX assets onto
      the ground in the scene.\n\n<b>3</b>.  In the <b>Inspector</b> window, change
      the <b>Position</b> coordinates as follows:\n\nX = 0 | Y = 0 | Z = 0 \n\n<b>4</b>. 
      Enter Play mode and check out the visual effect you just added."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
