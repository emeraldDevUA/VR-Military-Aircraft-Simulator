  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: '<b>1</b>.  In the <b>Project</b> window, open the <b>Assets</b>
      > <b>Audio</b> folder.


      <b>2</b>.  Click and drag any of the Audio assets
      into the <b>Hierarchy</b> window.


      <b>3</b>.  Enter Play mode and listen
      to the audio you just added.


      <b>Note</b>: If you don''t like the audio,
      you can delete it from the <b>Hierarchy</b> window by right clicking it and
      selecting <b>Delete</b>, then drag in a different audio option.'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
--- !u!114 &-8390340629188191517
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Congratulations! You just completed your first game in Unity.
      \n\nIn the next optional tutorial, you'll learn how to upload your project
      to <b>Unity Play</b> so that you can experience it in a web browser.  \n\nAfter
      you upload your game, you can choose to make it private, only viewable with
      a link, or publicly available.\n\nThis way, you can easily share your Unity
      creations with friends, family, and the wider Unity community. Sharing your
      game is a fun way to showcase your creativity and also get feedback from others."
--- !u!114 &-8283912614388000219
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Animation is a key component of bringing a scene to life. Characters
      can have animations, like walking, running, or jumping. \n\nObjects in the
      scene can also be animated, like a tree swaying in the wind or a ball bouncing
      up and down.\n\nGameObjects can be animated using Unity's animation tools,
      or animations can be imported from other applications.\n"
--- !u!114 &-8254731913347810657
MonoBehaviour:
  m_ObjectHideFlags: 1
