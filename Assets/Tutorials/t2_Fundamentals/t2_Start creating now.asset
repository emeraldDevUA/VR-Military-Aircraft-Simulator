--- !u!114 &-656090211160001596
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: "<b>1</b>.  Select the <b>Cube</b> GameObject you just added.\n\n<b>2</b>. 
      Select the <b>Scale</b> tool from the <b>Tool</b> overlay.\n\n<b>3</b>.  Select
      and drag the handles of the <b>Scale</b> gizmo to change the dimensions of
      the cube. \n\n<b>4</b>.  Use the <b>Move</b>, <b>Rotate</b>, and <b>Scale</b>
      tools to change the cube into a ramp to the other platform.\n\n<b>Important</b>:
      Transforming a cube can be very frustrating, especially when you\u2019re just
      getting the hang of the <b>Move</b>, <b>Rotate</b>, and <b>Scale</b> tools,
      but it\u2019s worth testing out your skills.\n\n<b>5</b>.  Enter Play mode
      and have the robot collect the last star.\n\n<b>6</b>.  When you\u2019re finished,
      don\u2019t forget to exit Play mode."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
