--- !u!114 &-3201304387736023805
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: "<b>1</b>.  In either the <b>Hierarchy</b> window or the <b>Scene</b>
      view, select the <b>Stairs</b> GameObject. \n\n<b>2</b>.  Select the <b>Rotate</b>
      tool from the <b>Tool</b> overlay.\n\n<b>3</b>.  Select and drag the handles
      of the <b>Rotate</b> gizmo to rotate the stairs so they\u2019re the right way
      up and at the correct angle.\n\n<b>Tip</b>: Click and drag in a straight line
      instead of trying to rotate around the GameObject.\n\n<b>4</b>.  Enter Play
      mode and have the robot collect the third star.\n\n<b>5</b>.  Remember to save
      your scene as you make changes.\n"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
