  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Let\u2019s add some stairs to allow the robot to get the third
      star on top of the red box.\n\nWe\u2019ve provided you with a set of stairs
      in the <b>Assets</b> folder.\n"
--- !u!114 &9093286637800105136
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: '<b>1</b>.  Watch the video above.


      <b>2</b>.  In the
      <b>Project</b> window, open the <b>Assets</b> > <b>Prefabs</b> folder.


      <b>Important</b>:
      Single-click, don''t double-click, the stairs asset (<a href="https://learn.unity.com/tutorial/671be8afedbc2a0105a17c0e#671bf065edbc2a0105919b3b">Help</a>).


      <b>3</b>. 
      In the <b>Project</b> window, select the <b>Stairs</b> GameObject and drag
      it onto the ground in the <b>Scene</b> view.


      <b>Note</b>: Don''t worry
      that the stairs are on their side; you''ll fix that later!

'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
