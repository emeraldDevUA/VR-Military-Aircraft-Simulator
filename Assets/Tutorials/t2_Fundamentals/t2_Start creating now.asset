    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: "<b>1</b>.  In the <b>Project</b> window, open the <b>Assets</b>
      > <b>Materials</b> folder.\n\n<b>2</b>.  Select any material and look at its
      preview in the <b>Inspector</b> window.\n\n<b>Important</b>: Single-click,
      don't double-click the material.\n\n<b>3</b>.  From the <b>Project</b> window,
      drag your selected material onto the white ground in the <b>Scene</b> view.\n\n<b>Note</b>:
      While a material loads, the GameObject you're applying it to might be highlighted
      in blue. \n"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
