  Text:
    m_Untranslated: "The robot is not currently able to reach the second star on
      the orange box. \n\nYou'll need to move the smaller orange box closer to help
      the robot reach the star. \n\nFollow the instructions below to get a closer
      look at the orange boxes."
--- !u!114 &-5751489762432400961
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: '<b>1</b>.  Watch the video above.


      <b>2</b>.  In the
      <b>Project</b> window, open the folder <b>Assets</b> > <b>Skyboxes</b>.


      <b>3</b>. 
      Select any skybox to preview it in the <b>Inspector</b> window.


      <b>4</b>. 
      Drag any skybox material to the sky area in the scene.

'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
