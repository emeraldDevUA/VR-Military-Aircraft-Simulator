--- !u!114 &6068856719604309560
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: '<b>1</b>.  In the <b>Hierarchy</b> window, select the <b>02_Box_Orange</b>
      GameObject.


      <b>2</b>.  Drag the blue and red handles (the arrowheads)
      of the <b>Move</b> gizmo to position the smaller orange box close to the larger
      box.


      <b>3</b>.  Enter Play mode and have the robot collect the second
      star.


      <b>4</b>.  When you''re finished, exit Play mode and save the
      scene.'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
