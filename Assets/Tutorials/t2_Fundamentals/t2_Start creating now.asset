  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "You now know the fundamentals of working in 3D, well done! \n\nYou
      might not feel confident yet, but that's OK. It'll take time and practice to
      really feel comfortable using the skills you just learned. \n\nTo continue
      your learning journey, begin the next tutorial: \"Explore the possibilities.\""
--- !u!114 &-6218593117435713287
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: 'When you select a GameObject using the <b>Move</b> tool, you''ll
      see three axis arrow handles appear on top of it.


      You can click and
      drag these handles to move the GameObject along each of the three dimensions
      (X, Y, and Z). '
--- !u!114 &-6154631092988974595
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: "<b>1</b>.  Select the <b>Add (+)</b> button in the upper-left
      corner of the <b>Hierarchy</b> window.\n\n<b>2</b>.  From the menu, select
      <b>3D Object</b> > <b>Cube</b>.\n\nA new GameObject named \u201CCube\u201D
      appears in the <b>Hierarchy</b> window and the <b>Scene</b> view.\n\n<b>3</b>. 
      Save your scene!\n"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
