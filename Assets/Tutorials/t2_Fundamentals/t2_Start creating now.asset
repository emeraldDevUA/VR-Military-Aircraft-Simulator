--- !u!114 &1597643385176081830
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: "<b>1</b>.  In the top-left corner of the <b>Scene</b> view,
      select the <b>View</b> tool (hand) from the <b>Tool</b> overlay.\n\n<b>2</b>. 
      In the <b>Scene</b> view, left-click and drag with your mouse to pan your view
      from side to side. \n\nThis allows you to move around in 3D space.\n\n<b>3</b>. 
      Instead of clicking as you typically would, right-click and drag with your
      mouse or touchpad to look around. \n\nThis allows you to stay in one spot and
      rotate your view.\n\n<b>Note</b>: If you're using a laptop and touchpad, the
      way you right-click will vary."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
--- !u!114 &2608227934413955447
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "There's one more star to collect in this scene; to reach it,
      you'll need a ramp. \n\nYou'll start with a simple cube, known as a <b>primitive</b>
      GameObject. Later, you'll transform that cube into a ramp.\n\nFollow the instructions
      below to add a primitive cube to your scene. \n"
--- !u!114 &2617556559709126981
