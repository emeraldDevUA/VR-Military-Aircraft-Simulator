<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console test of the filter outside Unity. The "~" in the folder name makes Unity ignore it
       (otherwise the Vector3 stub and test code would be compiled into the game). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- The filter itself is taken from ../Scripts, no copies -->
  <ItemGroup>
    <Compile Include="../Scripts/*.cs" />
  </ItemGroup>

</Project>
